# FLUENTRA Environment Variables

# Optional: Google Gemini API Key for direct cloud LLM dynamic lesson synthesis
# If not provided, FLUENTRA uses built-in smart generative synthesis engine
VITE_GEMINI_API_KEY=

# Firebase Configuration (for cloud authentication & cross-device Firestore syncing)
# Create a free project at https://console.firebase.google.com/
# Add a Web App and copy your configuration here:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
